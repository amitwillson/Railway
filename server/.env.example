# ---------------------------------------------------------------------------
# Railway Inspection & Compliance Management System - server configuration
# Copy to server/.env and adjust. Every value below has a working default in
# development; JWT_SECRET becomes mandatory when NODE_ENV=production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Where the SQLite database, uploads and backups live
DATA_DIR=./data
# DB_FILE=./data/railway-inspection.sqlite
# UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Comma separated list of browser origins allowed to call the API
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used in QR codes printed on reports
PUBLIC_URL=http://localhost:4000

# Authentication. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
SESSION_TIMEOUT_MINUTES=60
OTP_TTL_MINUTES=10
OTP_LENGTH=6
# Returns the OTP in the API response - development only, ignored in production
OTP_ECHO=true

# TDC reminder + escalation sweep
SCHEDULER_ENABLED=true
SCHEDULER_CRON=30 7 * * *
SCHEDULER_TZ=Asia/Kolkata

# Notification channels. In-app notifications are always on.
# When a channel is enabled without a gateway URL the message is written to the
# server log and recorded as sent by the "log" provider.
EMAIL_ENABLED=false
SMS_ENABLED=false
# SMTP_URL=https://mail-relay.internal/send
# SMS_GATEWAY_URL=https://sms-gateway.internal/send
FROM_EMAIL=no-reply@railway-inspection.local

# Password applied to every seeded demo account
SEED_PASSWORD=Railway@2026

# Set to true when running behind nginx / a load balancer
TRUST_PROXY=false
